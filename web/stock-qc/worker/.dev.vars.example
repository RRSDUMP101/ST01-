# Variable NAMES only – never put a value in this file or in git.
# Local `wrangler dev`: copy to .dev.vars (git-ignored) and fill in throw-away values.
# Deployed Worker: `npx wrangler secret put NAME` for each secret (staging account only).

# Owner login (Sales Office pattern). ADMIN_PASSWORD_HASH: bcrypt hash, cost 12–16:
#   node scripts/hash-password.mjs | npx wrangler secret put ADMIN_PASSWORD_HASH
# SESSION_SECRET: random, at least 32 characters (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Google Drive backup (later step; off unless SQ_DRIVE_BACKUP_ENABLED=true).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
SQ_DRIVE_BACKUP_FOLDER_ID=
SQ_DRIVE_BACKUP_ENABLED=

# Sales Office connector (later step; off by default). Domestic and Export secrets must be different values.
# SQ_SALES_BRIDGE: off (default) | pull | pull_push. Staging only – never production Sales Office.
SQ_SALES_URL=
SQ_SALES_CONNECTOR_ID=
SQ_SALES_DOMESTIC_SECRET=
SQ_SALES_EXPORT_SECRET=
SQ_SALES_BRIDGE=

# Optional: commits between R2 state snapshots (default 500).
SQ_SNAPSHOT_EVERY=
