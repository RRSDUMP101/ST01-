# Variable NAMES only – never put a value in this file or in git.
# Local `wrangler dev`: copy to .dev.vars (git-ignored) and fill in throw-away values.
# Deployed Worker: `npx wrangler secret put NAME` for each secret (staging account only).

# Owner login (Sales Office pattern). ADMIN_USERNAME: A-Z a-z 0-9 . _ @ -, 3–100 characters (no ":" or spaces).
# ADMIN_PASSWORD_HASH: bcrypt hash, cost 12–16 accepted; use 12 (what the script makes) so the owner's login answers as
# fast as every other account's and the owner's name cannot be told apart by timing:
#   node scripts/hash-password.mjs | npx wrangler secret put ADMIN_PASSWORD_HASH
# SESSION_SECRET: random, at least 32 characters (e.g. `openssl rand -hex 32`).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Google Drive backup of the commits (src/backup.js): off unless SQ_DRIVE_BACKUP_ENABLED=true – manual runs too.
# Use a dedicated Google web OAuth client. The owner connects from the Backup page; the server encrypts its refresh
# token in D1 using SESSION_SECRET. Keep SESSION_SECRET stable or reconnect Google after rotating it.
# Request full https://www.googleapis.com/auth/drive for the pre-existing private folder and inherited-sharing checks;
# this scope also authorizes native Google Sheets operations. Enable both Drive API and Sheets API in that project.
# SQ_GOOGLE_REDIRECT_URI: exact HTTPS origin + /api/backup/google/callback, also registered on the Google OAuth client.
# SQ_DRIVE_BACKUP_FOLDER_ID: a PRIVATE folder owned by the connected account (not shared, not in a shared drive).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Optional legacy server secret only. A saved encrypted D1 connection takes precedence; never expose either to UI.
GOOGLE_DRIVE_REFRESH_TOKEN=
SQ_GOOGLE_REDIRECT_URI=
SQ_DRIVE_BACKUP_FOLDER_ID=
SQ_DRIVE_BACKUP_ENABLED=
# Add a native Google Sheets snapshot alongside JSONL and manifest.json. Both switches must be true.
SQ_SHEETS_EXPORT_ENABLED=
# Optional, tests only: smaller JSONL parts (bytes, 1024 … 4194304; default 4 MB).
SQ_BACKUP_PART_BYTES=

# Sales Office connector (src/sales-bridge.js): off by default. SQ_SALES_URL = https origin of a STAGING Sales Office
# only (no path). Each workspace has its own secret (Sales Office RRS_PARTLIST_DOMESTIC_SECRET / RRS_PARTLIST_EXPORT_SECRET),
# at least 32 characters, and the two must be different values. SQ_SALES_BRIDGE: off (default) | pull | pull_push.
# pull_push only when the ST01 desktop connector is off for that workspace (decision ค-10: one connector per workspace).
# The connector writes jobs as the engine user bound to the owner account (ADMIN_USERNAME).
SQ_SALES_URL=
SQ_SALES_CONNECTOR_ID=
SQ_SALES_DOMESTIC_SECRET=
SQ_SALES_EXPORT_SECRET=
SQ_SALES_BRIDGE=

# Optional: commits between R2 state snapshots (default 500).
SQ_SNAPSHOT_EVERY=
